# Server-side only. Never prefix with NEXT_PUBLIC_.

# --- Option B/C (not in use): odds-api.io carries Norsk Tipping automatically (paid) ---
ODDS_API_IO_KEY=
# Bookmaker display name exactly as returned by GET /v3/bookmakers (verify with `npm run probe:odds-api-io`)
ODDS_API_IO_TARGET_BOOKMAKER=Norsk Tipping
# Comma-separated reference books, as named by the provider. Must be selected on your odds-api.io account.
# Verified available on odds-api.io (2026-11-01). Pinnacle is NOT offered by odds-api.io.
ODDS_API_IO_REFERENCE_BOOKMAKERS=Betfair Exchange,Sbobet,SingBet,Bet365,Unibet,William Hill,Marathonbet,1xbet,Bwin
# --- Option A (current): reference odds from The Odds API (free plan: 500 credits/month) ---
# Get a free key at https://the-odds-api.com . Without it the app runs on clearly labelled DEMO data.
THE_ODDS_API_KEY=
THE_ODDS_API_REGIONS=eu
THE_ODDS_API_MARKETS=h2h,totals
# Seconds to reuse a league's reference odds (each fresh fetch costs regions x markets credits)
REF_CACHE_SECONDS=90
# Optional: Postgres/Supabase connection string. If empty, a local PGlite database in ./data/pglite is used.
DATABASE_URL=

API_FOOTBALL_KEY=
