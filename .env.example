# Server-side only. Never prefix with NEXT_PUBLIC_.
ODDS_API_IO_KEY=
# Bookmaker display name exactly as returned by GET /v3/bookmakers (verify with `npm run probe:odds-api-io`)
ODDS_API_IO_TARGET_BOOKMAKER=Norsk Tipping
# Comma-separated reference books, as named by the provider. Must be selected on your odds-api.io account.
# Verified available on odds-api.io (2026-11-01). Pinnacle is NOT offered by odds-api.io.
ODDS_API_IO_REFERENCE_BOOKMAKERS=Betfair Exchange,Sbobet,SingBet,Bet365,Unibet,William Hill,Marathonbet,1xbet,Bwin
API_FOOTBALL_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
